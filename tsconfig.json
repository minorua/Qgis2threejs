{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "noEmit": true,
    "strict": false,

    "rootDir": "web/src/",
    "outDir": "web/src/types",

    "paths": {
      "three": ["./node_modules/@types/three"],
      "three/addons/*": ["./node_modules/@types/three/examples/jsm/*"]
    }
  },
  "include": [
    "web/src/**/*.js",
    "web/src/**/*.ts"
  ],
  "exclude": [
    "web/src/types"
  ]
}
